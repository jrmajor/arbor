{
	"name": "jrmajor/arbor",
	"description": "Genealogy application built in PHP",
	"license": "MIT",
	"type": "project",
	"keywords": [
		"arbor",
		"genealogy"
	],
	"require": {
		"php": "~8.4.0",
		"cweagans/composer-patches": "^2.0",
		"guzzlehttp/guzzle": "^7.10",
		"inertiajs/inertia-laravel": "^3.0",
		"jrmajor/laravel-fluent": "^1.3",
		"laravel/framework": "^12.56",
		"laravel/telescope": "^5.19",
		"laravel/tinker": "^2.11",
		"laravel/ui": "^4.6",
		"league/flysystem-aws-s3-v3": "^3.32",
		"nesbot/carbon": "^3.11",
		"php-standard-library/php-standard-library": "^6.1",
		"sentry/sentry-laravel": "^4.24",
		"spatie/laravel-activitylog": "^5.0",
		"spatie/laravel-schedule-monitor": "^4.3",
		"spatie/laravel-sitemap": "^7.4",
		"symfony/css-selector": "^8.0",
		"symfony/dom-crawler": "^8.0",
		"symfony/mailgun-mailer": "^8.0",
		"tightenco/ziggy": "^2.6"
	},
	"require-dev": {
		"barryvdh/laravel-debugbar": "^4.0",
		"barryvdh/laravel-ide-helper": "^3.7",
		"brianium/paratest": "^7.20",
		"fakerphp/faker": "^1.24",
		"jrmajor/cs": "^0.7.0",
		"larastan/larastan": "^3.9",
		"laravel/pail": "^1.2",
		"mockery/mockery": "^1.6",
		"nunomaduro/collision": "^8.9",
		"php-standard-library/phpstan-extension": "^2.0",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-mockery": "^2.0",
		"phpstan/phpstan-phpunit": "^2.0",
		"phpunit/phpunit": "^13.0",
		"spatie/laravel-ignition": "^2.12"
	},
	"minimum-stability": "stable",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"App\\": "app/",
			"Database\\Factories\\": "database/factories/",
			"Database\\Seeders\\": "database/seeders/"
		},
		"files": [
			"app/helpers.php",
			"helpers.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"cweagans/composer-patches": true
		},
		"sort-packages": true
	},
	"extra": {
		"laravel": {
			"dont-discover": []
		}
	},
	"scripts": {
		"post-update-cmd": [
			"@php artisan vendor:publish --tag=laravel-assets --ansi"
		],
		"pre-package-uninstall": [
			"Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
		],
		"post-autoload-dump": [
			"Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
			"@php artisan package:discover --ansi"
		],
		"setup": [
			"@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
			"@php artisan key:generate",
			"touch database/database.sqlite"
		],
		"dev": [
			"Composer\\Config::disableProcessTimeout",
			"pnpx concurrently -k -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"pnpm run dev\" --names=server,queue,logs,vite"
		],
		"preview": [
			"Composer\\Config::disableProcessTimeout",
			"pnpm run build",
			"pnpx concurrently -k -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"pnpm exec php artisan inertia:start-ssr\" --names=server,queue,logs,ssr"
		],
		"check": "phpstan --memory-limit=2G",
		"format": "php-cs-fixer fix --diff -v",
		"test": "@php artisan test --parallel"
	}
}
