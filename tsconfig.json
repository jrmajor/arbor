{
	"compilerOptions": {
		"noEmit": true,
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"checkJs": true,
		"skipLibCheck": true,
		"paths": {
			"@/*": ["resources/js/*"],
			"ziggy-js": ["vendor/tightenco/ziggy"],
		},
		"types": ["node", "vite/client"],
	},
	"include": [
		"resources/js/**/*.ts",
		"resources/js/**/*.svelte",
		"*.config.ts",
		"*.config.js",
	],
}
