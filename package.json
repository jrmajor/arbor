{
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && vite build --ssr",
		"check": "php artisan ziggy:generate --types-only && svelte-check --config ./svelte.config.js --tsconfig ./tsconfig.json --diagnostic-sources js,svelte --fail-on-warnings",
		"check:watch": "php artisan ziggy:generate --types-only && svelte-check --config ./svelte.config.js --tsconfig ./tsconfig.json --diagnostic-sources js,svelte --watch",
		"lint": "eslint . --max-warnings 0 --cache --cache-location .cache/eslint --cache-strategy content"
	},
	"dependencies": {
		"@fluent/bundle": "^0.19.1",
		"@github/hotkey": "^3.1",
		"@inertiajs/core": "^3.11",
		"@inertiajs/svelte": "^3.11",
		"@tailwindcss/forms": "^0.5.11",
		"date-fns": "^4.4",
		"runed": "^0.38.0",
		"svelte": "^5.57",
		"tailwindcss": "^4.3"
	},
	"devDependencies": {
		"@fluent/syntax": "^0.19.0",
		"@inertiajs/vite": "^3.11",
		"@jrmajor/eslint-config": "^0.3.0",
		"@sveltejs/vite-plugin-svelte": "^7.3",
		"@tailwindcss/vite": "^4.3",
		"@types/node": "^26.6",
		"@types/qs": "^6.15",
		"eslint": "^10.14",
		"globals": "*",
		"laravel-vite-plugin": "^3.2",
		"svelte-check": "^4.7",
		"typescript": "^6.0",
		"vite": "^8.3",
		"vite-plugin-run": "^0.9.1"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.18.0"
		},
		"runtime": {
			"name": "node",
			"version": "^26.13",
			"onFail": "download"
		}
	}
}
